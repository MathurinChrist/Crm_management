{# templates/emails/reset_password.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Réinitialisation de mot de passe{% endblock %}

{% block body %}
    <p>Bonjour {{ nom }} },</p>

    <p>
        Vous avez demandé la réinitialisation de votre mot de passe avec cette addresse: {{ userEmail }}.<br>
        Cliquez sur le lien ci-dessous pour définir un nouveau mot de passe :
    </p>

    <p>
        <a href="{{ resetUrl }}">{{ resetUrl }}</a>
    </p>

    <p>
        Ce lien expirera dans 1 heure. Si vous n’avez pas fait cette demande, vous pouvez ignorer cet e-mail.
    </p>

{% endblock %}
